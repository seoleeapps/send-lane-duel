config_version=5

[application]
config/name="Three Purses"
config/version="0.1.1"
config/icon="res://assets/art/castle.png"
boot_splash/image="res://assets/art/castle.png"
boot_splash/bg_color=Color(0.05, 0.14, 0.17, 1)
run/main_scene="res://godot/scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.12, 0.12, 0.12, 1)

[internationalization]
locale/translations=PackedStringArray("res://assets/i18n/ui.en.translation", "res://assets/i18n/ui.ko.translation")
locale/fallback="en"
